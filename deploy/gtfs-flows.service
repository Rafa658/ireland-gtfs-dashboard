[Unit]
Description=Prefect runner for GTFS polling, archive, and dbt flows
After=network-online.target docker.service
Wants=network-online.target

[Service]
WorkingDirectory=%h/ireland-gtfs-dashboard
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=%h/ireland-gtfs-dashboard/src"
Environment="PREFECT_API_URL=http://127.0.0.1:4200/api"
Environment="PREFECT_RUNNER_SERVER_ENABLE=false"
ExecStart=%h/.local/bin/poetry run python -m dags.serve
Restart=always
RestartSec=10
TimeoutStopSec=300

[Install]
WantedBy=default.target
