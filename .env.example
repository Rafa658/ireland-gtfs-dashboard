API_KEY=CHANGE_ME
APP_PORT=1000
POLL_INTERVAL_SECONDS=120
API_TIMEOUT_SECONDS=30
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
POSTGRES_HOST=CHANGE_ME
POSTGRES_PORT=5432
POSTGRES_DB=CHANGE_ME
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_SCHEMA=gtfs
POSTGRES_TABLE=snapshots
POSTGRES_SSLMODE=prefer
LOG_LEVEL=INFO

# Shared private Docker network containing PostgreSQL and MinIO.
GTFS_SHARED_NETWORK=gtfs-shared

# Prefect control plane. URL-encode special characters in the database password.
PREFECT_PRIVATE_IP=CHANGE_ME
PREFECT_PORT=4200
PREFECT_API_AUTH_STRING=CHANGE_ME:CHANGE_ME
PREFECT_SERVER_DATABASE_CONNECTION_URL=postgresql+asyncpg://prefect:CHANGE_ME@postgres:5432/prefect
PREFECT_WORK_POOL=gtfs-local
PREFECT_LOGGING_LEVEL=INFO

# MinIO archive destination.
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=gtfs-ireland
MINIO_REGION=us-east-1

# Archive and retention behavior.
ARCHIVE_PREFIX=realtime
ARCHIVE_TIMEZONE=America/Sao_Paulo
ARCHIVE_INITIAL_START=2026-09-19T00:00:00-03:00
ARCHIVE_MAX_CATCHUP_HOURS=24
FAILURE_WEBHOOK_URL=
