API_KEY=CHANGE_ME
APP_PORT=1000
POLL_INTERVAL_SECONDS=120
API_TIMEOUT_SECONDS=30
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
POSTGRES_HOST=CHANGE_ME
POSTGRES_PORT=5432
POSTGRES_DB=CHANGE_ME
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_SCHEMA=gtfs
POSTGRES_TABLE=snapshots
POSTGRES_SSLMODE=prefer
LOG_LEVEL=INFO

# Shared Docker network that already hosts the Postgres and MinIO containers.
GTFS_SHARED_NETWORK=gtfs-shared

# MinIO target for the hourly Parquet archive.
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=gtfs-ireland
MINIO_REGION=us-east-1

# Archive layout and the local zone used for hour windows and partition dates (UTC-3).
ARCHIVE_PREFIX=realtime
ARCHIVE_TIMEZONE=America/Sao_Paulo
RETENTION_DAYS=3

# Prefect server. PREFECT_PRIVATE_IP is used by your BROWSER, so it must be an address
# that resolves from your machine (a LAN IP). host.docker.internal will NOT work here.
PREFECT_PORT=4200
PREFECT_PRIVATE_IP=CHANGE_ME
PREFECT_LOGGING_LEVEL=INFO
# Prefect's own metadata database. Must point at a reachable host (a LAN IP, not
# host.docker.internal) and the database must already exist.
PREFECT_SERVER_DATABASE_CONNECTION_URL=postgresql+asyncpg://CHANGE_ME:CHANGE_ME@CHANGE_ME:5432/prefect
